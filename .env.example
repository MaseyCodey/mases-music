NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_bcrypt_hash
JWT_SECRET=replace_with_at_least_32_random_bytes
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
GITHUB_REPOSITORY=your-github-name/mases-music
GITHUB_BRANCH=main
GITHUB_MUSIC_PATH=music
GITHUB_TOKEN=replace_with_fine_grained_github_token
